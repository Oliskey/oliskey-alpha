# Leave empty for web: the backend serves the app on one port (http://localhost:3311) and the app uses that address.
# For a phone (Expo Go / native build) set your computer's LAN address, e.g. http://192.168.1.20:3311
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WS_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
