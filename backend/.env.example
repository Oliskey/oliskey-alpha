PORT=3311
# Local Docker Postgres (npm run db:up). For hosted Supabase use its direct connection string.
DATABASE_URL=postgres://postgres:oliskey_alpha_local@127.0.0.1:54330/oliskey_alpha
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Comma-separated. The web app is served by this backend on the same port, so this only matters for other origins.
ALLOWED_ORIGINS=http://localhost:3311

# Set to 1 only when a proxy sits in front (Render/Railway), so rate limits see the real client IP
TRUST_PROXY=0

# Postgres connections the backend may open (default 20)
DB_POOL_MAX=20

# Sign-up/login attempts per IP per 15 min (default 30). Raise only for test runs.
AUTH_RATE_LIMIT=30

# Signal alerts when the app is closed. Create with: npx web-push generate-vapid-keys. Leave empty to keep them off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
