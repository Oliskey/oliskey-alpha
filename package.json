{
  "name": "oliskey-alpha",
  "version": "0.0.23",
  "private": true,
  "workspaces": [
    "backend",
    "app"
  ],
  "scripts": {
    "db:up": "node scripts/db.mjs up",
    "db:reset": "node scripts/db.mjs reset",
    "db:test": "node scripts/db.mjs test",
    "db:clean-test": "node scripts/clean-test-accounts.mjs",
    "db:admin": "node scripts/db.mjs admin",
    "build": "npm run build -w app",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "start": "node scripts/run-server.mjs",
    "start:all": "npm run db:up && npm start",
    "test": "npm test -w backend",
    "app:dev": "npm run web -w app",
    "spot:test": "node scripts/spot.mjs test",
    "spot:fetch": "node scripts/spot.mjs fetch",
    "spot:lab": "node scripts/spot.mjs lab"
  },
  "engines": {
    "node": ">=22.13"
  }
}
